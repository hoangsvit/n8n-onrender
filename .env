# Example values for local/manual deployments only.
# Render Blueprint deployments get PostgreSQL variables from render.yaml.

N8N_LISTEN_ADDRESS=0.0.0.0
N8N_PORT=5678
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true

# Set N8N_ENCRYPTION_KEY privately in your environment. Never commit its value,
# and never replace the key of an existing n8n instance.
N8N_ENCRYPTION_KEY=

# Optional when using a custom domain. Render derives these automatically for
# the default onrender.com hostname.
N8N_PROTOCOL=https
N8N_HOST=
N8N_EDITOR_BASE_URL=
N8N_WEBHOOK_URL=

GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
TZ=Asia/Ho_Chi_Minh
N8N_LOG_LEVEL=info

DB_TYPE=postgresdb
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_POOL_SIZE=2
DB_POSTGRESDB_CONNECTION_TIMEOUT=30000
DB_POSTGRESDB_DESTROY_TIMEOUT_MS=10000
DB_STARTUP_CONNECT_MAX_RETRIES=10
DB_PING_INTERVAL_SECONDS=10
DB_PING_MAX_FAILURES_BEFORE_RECOVERY=5

NODE_OPTIONS=--max-old-space-size=1024
N8N_CONCURRENCY_PRODUCTION_LIMIT=5
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false

# Secure default: allow only verified community packages. Set to true only
# after explicitly reviewing and approving an unverified package.
N8N_UNVERIFIED_PACKAGES_ENABLED=false
N8N_RUNNERS_TASK_TIMEOUT=60
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=268435456
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=1000
